{
    "$schema": "https://design-tokens.github.io/community-group/format/",
    "layout": {
        "container": {
            "maxWidth": {
                "$value": "1200px"
            }
        },
        "gutter": {
            "mobile": {
                "$value": "{spacing.4}"
            },
            "tablet": {
                "$value": "{spacing.5}"
            },
            "laptop": {
                "$value": "{spacing.6}"
            },
            "desktop": {
                "$value": "{spacing.8}"
            }
        },
        "pageMargin": {
            "mobile": {
                "$value": "{spacing.5}"
            },
            "tablet": {
                "$value": "{spacing.8}"
            },
            "laptop": {
                "$value": "{spacing.12}"
            },
            "desktop": {
                "$value": "{spacing.16}"
            }
