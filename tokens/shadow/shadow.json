{
    "$schema": "https://design-tokens.github.io/community-group/format/",
    "shadow": {
        "none": {
            "$value": "none"
        },
        "sm": {
            "$value": "0 1px 2px rgba(0, 0, 0, 0.08)"
        },
        "md": {
            "$value": "0 4px 8px rgba(0, 0, 0, 0.12)"
        },
        "lg": {
            "$value": "0 8px 16px rgba(0, 0, 0, 0.16)"
        },
        "xl": {
            "$value": "0 16px 32px rgba(0, 0, 0, 0.20)"
        }
    }
}