{
    "$schema": "https://design-tokens.github.io/community-group/format/",
    "typography": {
        "scale": {
            "xs": {
                "fontSize": {
                    "$value": "0.75rem"
                },
                "lineHeight": {
                    "$value": 1.4
                }
            },
            "sm": {
                "fontSize": {
                    "$value": "0.875rem"
                },
                "lineHeight": {
                    "$value": 1.4
                }
            },
            "md": {
                "fontSize": {
                    "$value": "1rem"
                },
                "lineHeight": {
                    "$value": 1.5
                }
            },
            "lg": {
                "fontSize": {
                    "$value": "1.125rem"
                },
                "lineHeight": {
                    "$value": 1.5
                }
            },
            "xl": {
                "fontSize": {
                    "$value": "1.25rem"
                },
                "lineHeight": {
                    "$value": 1.5
                }
            },
            "2xl": {
                "fontSize": {
                    "$value": "1.5rem"
                },
                "lineHeight": {
                    "$value": 1.4
                }
            },
            "3xl": {
                "fontSize": {
                    "$value": "1.75rem"
                },
                "lineHeight": {
                    "$value": 1.3
                }
            },
            "4xl": {
                "fontSize": {
                    "$value": "2rem"
                },
                "lineHeight": {
                    "$value": 1.2
                }
            },
            "5xl": {
                "fontSize": {
                    "$value": "2.5rem"
                },
                "lineHeight": {
                    "$value": 1.15
                }
            }
        },
        "letterSpacing": {
            "tight": {
                "$value": "-0.02em"
            },
            "normal": {
                "$value": "0em"
            },
            "wide": {
                "$value": "0.03em"
            },
            "wider": {
                "$value": "0.05em"
            }
        }
    }
}