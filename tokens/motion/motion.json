{
    "$schema": "https://design-tokens.github.io/community-group/format/",
    "motion": {
        "duration": {
            "instant": {
                "$value": "0ms"
            },
            "fast": {
                "$value": "120ms"
            },
            "normal": {
                "$value": "200ms"
            },
            "slow": {
                "$value": "300ms"
            },
            "slower": {
                "$value": "500ms"
            }
        },
        "easing": {
            "linear": {
                "$value": "linear"
            },
            "standard": {
                "$value": "cubic-bezier(0.2, 0, 0, 1)"
            },
            "decelerate": {
                "$value": "cubic-bezier(0, 0, 0.2, 1)"
            },
            "accelerate": {
                "$value": "cubic-bezier(0.4, 0, 1, 1)"
            }
        }
    }
}